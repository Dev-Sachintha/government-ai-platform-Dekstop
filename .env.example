# ---- Cloud database (Supabase PostgreSQL) -------------------------------------------------
# Supabase Dashboard > Project Settings > Database > Connection string > URI
# First run: use the "postgres" connection so the app can create the tables itself.
# Production desktops: create the restricted login role from DESKTOP_CLOUD_MIGRATION.md section 3,
# put ITS connection string here and set GOVAI_SKIP_SCHEMA=1.
SUPABASE_DB_URL=
# GOVAI_SKIP_SCHEMA=1
# GOVAI_DB_POOL_MAX=8

# ---- First accounts (REQUIRED with the cloud database; the built-in defaults are refused) ----
ADMIN_PASSWORD=
ANALYST_PASSWORD=

# ---- AI provider ----------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ---- Optional Android/PC monitor API ---------------------------------------------------------
MOBILE_MONITOR_API_URL=https://government-ai-mobile-monitor.onrender.com
MOBILE_MONITOR_API_KEY=
