# Supabase Dashboard > Project Settings > Database > Connection string > URI
# Use a dedicated database role with access only to public.platform_snapshots.
SUPABASE_DB_URL=postgresql://govai_client:CHANGE_ME@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
GOVAI_CLOUD_APP_ID=government-ai-platform
# Optional initial account passwords; change before first launch.
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD
ANALYST_PASSWORD=CHANGE_THIS_ANALYST_PASSWORD
# Optional Android/PC monitor API settings
MOBILE_MONITOR_API_URL=
MOBILE_MONITOR_API_KEY=
